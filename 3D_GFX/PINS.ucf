NET "CLK" LOC = "A13";






NET tmds0b LOC ="A4";
NET tmds0a LOC ="A5";

NET tmds1b LOC ="A6";
NET tmds1a LOC ="A7";

NET tmds2b LOC ="A8";
NET tmds2a LOC ="A9";

NET tmds_clkb LOC ="A10";
NET tmds_clka LOC ="A11";




 




 
 
NET DATAS LOC ="C26"; 
NET CLOCKS LOC ="C25";
NET WRITE LOC ="C24"; 
NET DREQ LOC ="C21"; 
NET MODE_IN LOC ="C1"; 

 

NET "CLOCKS" CLOCK_DEDICATED_ROUTE = FALSE;
NET "WRITE" CLOCK_DEDICATED_ROUTE = FALSE;
 
 
 
 ///PIN "XLXI_2247/COUNT_0_BUFG.O" CLOCK_DEDICATED_ROUTE = FALSE;
 
 
  ///PIN "XLXI_2371/CLOCK_OUT2_BUFG.O" CLOCK_DEDICATED_ROUTE = FALSE;
  





















## --------------------------------------------------------------------
## Clock and command, shared by both devices
## --------------------------------------------------------------------
NET "sd_clk"    LOC = "AE26"  ;
NET "sd_we_n"   LOC = "AE1"   ;
NET "sd_cas_n"  LOC = "AD1"    ;
NET "sd_ras_n"  LOC = "AC1"   ;

## --------------------------------------------------------------------
## Address, shared by both devices. A10 doubles as the precharge-all
## and auto-precharge control, so it is used even in a one-bank build.
## --------------------------------------------------------------------
NET "sd_addr<0>"  LOC = "V1"   ;
NET "sd_addr<1>"  LOC = "W1"   ;
NET "sd_addr<2>"  LOC = "Y1"   ;
NET "sd_addr<3>"  LOC = "AA1"  ;
NET "sd_addr<4>"  LOC = "G26"  ;
NET "sd_addr<5>"  LOC = "H26"  ;
NET "sd_addr<6>"  LOC = "J26"  ;
NET "sd_addr<7>"  LOC = "K26"  ;
NET "sd_addr<8>"  LOC = "L26"  ;
NET "sd_addr<9>"  LOC = "M26"  ;
NET "sd_addr<10>" LOC = "AB1"  ;
NET "sd_addr<11>" LOC = "N26"  ;
NET "sd_addr<12>" LOC = "AD26" ;

## --------------------------------------------------------------------
## Data, SDRAM 1 -> sd_dq[15:0]
## --------------------------------------------------------------------
NET "sd_dq<0>"   LOC = "AC3"  ;
NET "sd_dq<1>"   LOC = "AC4"  ;
NET "sd_dq<2>"   LOC = "AC5"  ;
NET "sd_dq<3>"   LOC = "AC7"  ;
NET "sd_dq<4>"   LOC = "AC9"  ;
NET "sd_dq<5>"   LOC = "AC11" ;
NET "sd_dq<6>"   LOC = "AC14" ;
NET "sd_dq<7>"   LOC = "AC15" ;
NET "sd_dq<8>"   LOC = "AC16" ;
NET "sd_dq<9>"   LOC = "AC17" ;
NET "sd_dq<10>"  LOC = "AC19" ;
NET "sd_dq<11>"  LOC = "AC20" ;
NET "sd_dq<12>"  LOC = "AC23" ;
NET "sd_dq<13>"  LOC = "AC24" ;
NET "sd_dq<14>"  LOC = "AC25" ;
NET "sd_dq<15>"  LOC = "AC26" ;

## --------------------------------------------------------------------
## Data, SDRAM 2 -> sd_dq[31:16]
##
## Note this chip's DQ0..DQ7 sit on AA5..AA14 and DQ8..DQ15 on
## AA15..AA26, so the ball order runs the opposite way from SDRAM 1.
## That does not matter electrically -- a data bus only has to be
## consistent between write and read, and both go through this same
## mapping -- but it is worth knowing when probing the board.
## --------------------------------------------------------------------
NET "sd_dq<16>"  LOC = "AA5"  ;
NET "sd_dq<17>"  LOC = "AA7"  ;
NET "sd_dq<18>"  LOC = "AA8"  ;
NET "sd_dq<19>"  LOC = "AA9"  ;
NET "sd_dq<20>"  LOC = "AA11" ;
NET "sd_dq<21>"  LOC = "AA12" ;
NET "sd_dq<22>"  LOC = "AA13" ;
NET "sd_dq<23>"  LOC = "AA14" ;
NET "sd_dq<24>"  LOC = "AA26" ;
NET "sd_dq<25>"  LOC = "AA25" ;
NET "sd_dq<26>"  LOC = "AA24" ;
NET "sd_dq<27>"  LOC = "AA23" ;
NET "sd_dq<28>"  LOC = "AA19" ;
NET "sd_dq<29>"  LOC = "AA18" ;
NET "sd_dq<30>"  LOC = "AA17" ;
NET "sd_dq<31>"  LOC = "AA15" ;

## ==================================================================























